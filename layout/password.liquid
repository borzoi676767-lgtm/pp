<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-time="day">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} — Opening soon</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'forest.css' | asset_url | stylesheet_tag }}
  {{ 'components.css' | asset_url | stylesheet_tag }}
  <style>
    :root{ --brand:{{ settings.color_forest }}; --accent:{{ settings.color_ember }}; }
    body{ min-height:100svh; display:grid; place-items:center; background:linear-gradient(180deg,#16283a,#0c1f2c); }
  </style>
  {{ content_for_header }}
</head>
<body class="template-password">
  {{ content_for_layout }}
</body>
</html>
