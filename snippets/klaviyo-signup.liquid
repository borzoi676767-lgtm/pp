{%- comment -%}
  Klaviyo signup bridge.

  THE PROBLEM THIS SOLVES
  The theme's signup forms are Shopify `{% form 'customer' %}` forms. Those create a
  Shopify customer with marketing consent, but Klaviyo only sees that customer when its
  Shopify integration next syncs — minutes to hours later, and only if the integration is
  connected. Until then no welcome flow fires, so the signup looks broken to the visitor.

  WHAT THIS DOES
  Intercepts submit on any `.js-klaviyo-form`, POSTs the subscriber straight to Klaviyo's
  Client Subscriptions API (profile + consent created immediately), then lets the Shopify
  form submit as normal so the customer record is still created. Both systems get the
  person; Klaviyo gets them instantly and any welcome flow fires right away.

  SETUP — you only need ONE value
    · List ID — Klaviyo → Audience → Lists → open your list → the ID in the URL.
      Paste it into Theme settings → Marketing → Klaviyo list ID.

  The public API key (company ID) is read automatically from the Klaviyo app embed's
  klaviyo.js tag, so there is nothing to copy for it. If you ever disable that app embed,
  set `klaviyo_public_key` manually and this keeps working.

  If no list ID is set, this stays completely inert and the forms behave exactly as before
  (the Shopify customer is still created — nothing is lost, it just isn't instant).
{%- endcomment -%}

{%- liquid
  comment
    List ID resolves from the shop metafield first (settable via API, survives theme
    swaps), then falls back to the theme setting for anyone editing in the admin.
  endcomment
  assign kl_list = shop.metafields.custom.klaviyo_list_id.value
  if kl_list == blank
    assign kl_list = settings.klaviyo_list_id
  endif
  assign kl_list = kl_list | strip

  assign kl_key = shop.metafields.custom.klaviyo_public_key.value
  if kl_key == blank
    assign kl_key = settings.klaviyo_public_key
  endif
  assign kl_key = kl_key | strip
-%}

{%- if kl_list != blank -%}
<script>
  (function () {
    var LIST = {{ kl_list | json }};
    var KEY  = {{ kl_key | json }};

    // The Klaviyo app embed loads https://static.klaviyo.com/onsite/js/<COMPANY_ID>/klaviyo.js
    // (older form: ...klaviyo.js?company_id=XXXXXX). Read the ID from whichever is present
    // so the merchant never has to copy their public key by hand.
    function companyId() {
      if (KEY) return KEY;
      var tags = document.querySelectorAll('script[src*="klaviyo.com"]');
      for (var i = 0; i < tags.length; i++) {
        var src = tags[i].src || "";
        var q = src.match(/[?&]company_id=([A-Za-z0-9]+)/);
        if (q) return q[1];
        var p = src.match(/\/onsite\/js\/([A-Za-z0-9]+)\//);
        if (p) return p[1];
      }
      return null;
    }

    function toE164(raw) {
      if (!raw) return null;
      var d = String(raw).replace(/[^\d+]/g, "");
      if (d.indexOf("+") === 0) return d;
      d = d.replace(/\D/g, "");
      if (d.length === 10) return "+1" + d;              // US/CA default
      if (d.length === 11 && d.charAt(0) === "1") return "+" + d;
      return d.length > 6 ? "+" + d : null;              // otherwise let Klaviyo validate
    }

    function subscribe(email, phone, source) {
      var key = companyId();
      if (!key) return Promise.reject("no company id");

      var subs = { email: { marketing: { consent: "SUBSCRIBED" } } };
      var attrs = { email: email };
      if (phone) {
        attrs.phone_number = phone;
        subs.sms = { marketing: { consent: "SUBSCRIBED" } };
      }
      attrs.subscriptions = subs;
      if (source) attrs.properties = { signup_source: source };

      return fetch("https://a.klaviyo.com/client/subscriptions/?company_id=" + encodeURIComponent(key), {
        method: "POST",
        headers: { "content-type": "application/json", revision: "2024-10-15" },
        body: JSON.stringify({
          data: {
            type: "subscription",
            attributes: {
              custom_source: source || "Storefront",
              profile: { data: { type: "profile", attributes: attrs } }
            },
            relationships: { list: { data: { type: "list", id: LIST } } }
          }
        })
      });
    }

    // Derive a readable signup source from the hidden fields the forms already carry.
    function sourceOf(form) {
      var ctx = form.querySelector('input[name="contact[context]"]');
      if (ctx && ctx.value) return ctx.value;
      var tags = form.querySelector('input[name="contact[tags]"]');
      if (tags && tags.value) return tags.value.split(",")[0];
      return "Storefront";
    }

    function bind(form) {
      if (form.__klaviyoBound) return;
      form.__klaviyoBound = true;

      form.addEventListener("submit", function (e) {
        if (form.__klaviyoSent) return;                  // second pass: let it through
        var emailEl = form.querySelector('input[type="email"]');
        var email = emailEl && emailEl.value && emailEl.value.trim();
        if (!email) return;                              // nothing to send; native validation handles it

        e.preventDefault();
        form.__klaviyoSent = true;

        var phoneEl = form.querySelector('input[type="tel"]');
        var phone = phoneEl ? toE164(phoneEl.value) : null;
        var source = sourceOf(form);

        var done = false;
        function go() {
          if (done) return;
          done = true;
          form.submit();                                 // hand off to Shopify
        }
        // Never let a slow or blocked network trap the customer on the form.
        setTimeout(go, 2500);
        subscribe(email, phone, source).then(go).catch(go);
      });
    }

    function bindAll() {
      document.querySelectorAll("form.js-klaviyo-form").forEach(bind);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", bindAll);
    } else {
      bindAll();
    }
    // Popup and cart drawer inject markup late; klaviyo.js may also load after us.
    document.addEventListener("shopify:section:load", bindAll);
    setTimeout(bindAll, 1200);
  })();
</script>
{%- endif -%}
