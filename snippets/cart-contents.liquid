{%- comment -%}
  The refreshable inner region of the cart drawer / page.
  Wrapped in [data-cart-section="cart-drawer"] so the Section Rendering API
  can swap it in place while the drawer shell (open state) persists.
{%- endcomment -%}
<div data-cart-section="cart-drawer" class="cart-contents{% if cart.item_count == 0 %} is-empty{% endif %}">
  {% render 'free-shipping-bar' %}

  {%- if cart.item_count == 0 -%}
    <div class="cart-empty">
      <div class="cart-empty__art">{% render 'icon', name: 'pine', size: 48 %}</div>
      <p class="cart-empty__msg">{{ 'cart.general.empty' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--accent" data-cart-close>{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <ul class="cart-lines" role="list">
      {%- for item in cart.items -%}
        <li class="cart-line" data-line-item>
          <a href="{{ item.url }}" class="cart-line__media" tabindex="-1" aria-hidden="true">
            {%- if item.image -%}
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
            {%- endif -%}
          </a>
          <div class="cart-line__info">
            <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
            {%- unless item.variant.title contains 'Default' -%}
              <p class="cart-line__variant">{{ item.variant.title }}</p>
            {%- endunless -%}
            {%- if item.selling_plan_allocation -%}
              <p class="cart-line__variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
            {%- endif -%}
            {%- if item.properties -%}
              {%- for p in item.properties -%}
                {%- unless p.first contains '_' or p.last == blank -%}
                  <p class="cart-line__prop">{{ p.first }}: {{ p.last }}</p>
                {%- endunless -%}
              {%- endfor -%}
            {%- endif -%}
            <div class="cart-line__controls">
              <div class="qty-stepper" data-qty>
                <button type="button" class="qty-stepper__btn" data-line-change="{{ item.quantity | minus: 1 }}" data-line="{{ forloop.index }}" aria-label="Decrease quantity">{% render 'icon', name: 'minus', size: 14 %}</button>
                <input class="qty-stepper__input" type="number" min="0" value="{{ item.quantity }}" data-line-qty data-line="{{ forloop.index }}" aria-label="{{ 'products.product.quantity' | t }}">
                <button type="button" class="qty-stepper__btn" data-line-change="{{ item.quantity | plus: 1 }}" data-line="{{ forloop.index }}" aria-label="Increase quantity">{% render 'icon', name: 'plus', size: 14 %}</button>
              </div>
              <button type="button" class="cart-line__remove" data-line-change="0" data-line="{{ forloop.index }}">{{ 'cart.general.remove' | t }}</button>
            </div>
          </div>
          <div class="cart-line__price">
            {%- if item.original_line_price > item.final_line_price -%}
              <s>{{ item.original_line_price | money }}</s><br>
            {%- endif -%}
            {{ item.final_line_price | money }}
          </div>
        </li>
      {%- endfor -%}
    </ul>

    <div class="cart-foot">
      <div class="cart-foot__row">
        <span>{{ 'cart.general.subtotal' | t }}</span>
        <strong>{{ cart.total_price | money }}</strong>
      </div>
      {%- if cart.total_discounts > 0 -%}
        <div class="cart-foot__row cart-foot__row--save"><span>Trail savings</span><span>−{{ cart.total_discounts | money }}</span></div>
      {%- endif -%}
      <p class="cart-foot__note">{{ 'cart.general.taxes_and_shipping' | t }}</p>
      {%- if settings.cart_trust != blank -%}<p class="cart-foot__trust">{% render 'icon', name: 'shield', size: 15 %} {{ settings.cart_trust }}</p>{%- endif -%}
      <div class="cart-foot__actions">
        <a href="{{ routes.cart_url }}" class="btn btn--ghost btn--full">{{ 'cart.general.title' | t }}</a>
        <button type="submit" name="checkout" form="cart-form" class="btn btn--accent btn--full btn--lg">{{ 'cart.general.checkout' | t }}</button>
      </div>
    </div>
  {%- endif -%}
</div>
