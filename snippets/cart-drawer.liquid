{%- comment -%} Persistent cart drawer shell (rendered once in layout). {%- endcomment -%}
<div id="cart-drawer" class="cart-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
  <div class="cart-drawer__overlay" data-cart-close></div>
  <aside class="cart-drawer__panel" tabindex="-1">
    <header class="cart-drawer__head">
      <h2 class="cart-drawer__title">{% render 'icon', name: 'pine', size: 20 %} {{ 'cart.general.title' | t }}</h2>
      <button type="button" class="cart-drawer__close" data-cart-close aria-label="{{ 'general.accessibility.close' | t }}">{% render 'icon', name: 'close', size: 20 %}</button>
    </header>
    <form id="cart-form" action="{{ routes.cart_url }}" method="post" class="cart-drawer__body">
      {% render 'cart-contents' %}
    </form>
  </aside>
</div>
