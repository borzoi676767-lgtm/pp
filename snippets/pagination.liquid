{%- comment -%} Params: paginate {%- endcomment -%}
{%- if paginate.pages > 1 -%}
  <nav class="pagination" role="navigation" aria-label="Pagination">
    <ul class="pagination__list">
      {%- if paginate.previous -%}
        <li><a class="pagination__link" href="{{ paginate.previous.url }}" aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</a></li>
      {%- endif -%}
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a class="pagination__link" href="{{ part.url }}" aria-label="{{ 'general.pagination.page' | t: number: part.title }}">{{ part.title }}</a>
          {%- else -%}
            <span class="pagination__link {% if part.title == paginate.current_page %}is-current{% endif %}" {% if part.title == paginate.current_page %}aria-current="page"{% endif %}>{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
      {%- if paginate.next -%}
        <li><a class="pagination__link" href="{{ paginate.next.url }}" aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', name: 'arrow-right', size: 18 %}</a></li>
      {%- endif -%}
    </ul>
  </nav>
  <style>
    .pagination__list{display:flex;gap:.4rem;justify-content:center;list-style:none;padding:0;margin:2.5rem 0 0;flex-wrap:wrap}
    .pagination__link{display:grid;place-items:center;min-width:44px;height:44px;padding:0 .6rem;border-radius:var(--r-md);border:1px solid var(--line);background:var(--surface);color:var(--ink);text-decoration:none;font-weight:600;transition:.2s}
    .pagination__link:hover{background:var(--forest-700);color:var(--cream-100);border-color:var(--forest-700)}
    .pagination__link.is-current{background:var(--forest-700);color:var(--cream-100);border-color:var(--forest-700)}
    .pagination li:first-child .pagination__link svg{transform:rotate(180deg)}
  </style>
{%- endif -%}
