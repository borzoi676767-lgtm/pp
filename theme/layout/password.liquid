<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="mc-scheme--basilica">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">{%- endif -%}
    <title>{{ shop.name }}</title>
    <meta name="description" content="{{ shop.description | default: shop.name | escape }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <meta property="og:title" content="{{ shop.name | escape }}">
    <meta property="og:type" content="website">
    {%- if settings.share_image -%}<meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">{%- endif -%}
    {%- if settings.type_body_font -%}{{ settings.type_body_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- if settings.type_heading_font -%}{{ settings.type_heading_font | font_face: font_display: 'swap' }}{%- endif -%}
    {%- style -%}
      :root {
        {%- if settings.type_body_font -%}--font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};{%- endif -%}
        {%- if settings.type_heading_font -%}--font-display: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};{%- endif -%}
        {%- if settings.color_accent != blank -%}--mc-accent: {{ settings.color_accent }};{%- endif -%}
        {%- if settings.color_background != blank -%}--mc-nero-marble-black: {{ settings.color_background }};{%- endif -%}
      }
      body { display: grid; place-items: center; min-height: 100vh; text-align: center; }
      .mc-password { max-width: 520px; padding: var(--mc-sp-6); display: grid; gap: var(--mc-sp-4); justify-items: center; }
      .mc-password__foot { margin-top: var(--mc-sp-6); color: var(--mc-text-muted); font-size: .85rem; }
      .mc-password__foot a { color: var(--mc-accent); }
    {%- endstyle -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>
  </body>
</html>
