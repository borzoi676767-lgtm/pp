<section class="mc-section mc-scheme--{{ section.settings.scheme }}">
  <div class="mc-container mc-container--narrow" style="text-align:center;display:grid;gap:16px;justify-items:center">
    {%- if section.settings.eyebrow != blank -%}<p class="mc-eyebrow mc-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="mc-h2 mc-reveal" data-delay="1">{{ section.settings.heading }}</h2>{%- endif -%}
    <hr class="mc-rule mc-reveal" data-delay="1">
    {%- if section.settings.text != blank -%}<div class="mc-lead mc-reveal" data-delay="2">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.cta_text != blank -%}<div class="mc-reveal" data-delay="2"><a class="mc-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a></div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [
      { "value": "basilica", "label": "Basilica (dark)" }, { "value": "parchment", "label": "Parchment (light)" }
    ], "default": "basilica" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "History inspires the aesthetic; Christ remains the message." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We make heirloom goods for a living Christian civilization.</p>" },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
