<section class="mc-section">
  <div class="mc-container">
    <header class="mc-collbanner">
      <p class="mc-eyebrow">The Library of Faith &amp; History</p>
      <h1 class="mc-h1">{{ blog.title }}</h1>
      <hr class="mc-rule">
    </header>

    {%- if blog.articles_count > 0 -%}
      {%- paginate blog.articles by section.settings.per_page -%}
        <div class="mc-grid mc-grid--3">
          {%- for article in blog.articles -%}
            <a class="mc-card mc-reveal" href="{{ article.url }}">
              <div class="mc-card__media">
                {%- if article.image -%}
                  {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360,540,720', sizes: '(min-width:990px) 33vw, 100vw', alt: article.title }}
                {%- else -%}
                  <div style="aspect-ratio:4/5;display:grid;place-items:center">{% render 'icon', name: 'book', size: 48 %}</div>
                {%- endif -%}
              </div>
              <div>
                <p class="mc-eyebrow" style="color:var(--mc-text-muted)">{{ article.published_at | date: '%B %e, %Y' }}</p>
                <h2 class="mc-card__title">{{ article.title }}</h2>
                <p style="color:var(--mc-text-muted)">{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
              </div>
            </a>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="mc-pagination" style="display:flex;gap:16px;justify-content:center;margin-top:48px" aria-label="Pagination">
            {%- if paginate.previous -%}<a class="mc-link-gold" href="{{ paginate.previous.url }}">&larr; {{ 'general.prev' | t | default: 'Previous' }}</a>{%- endif -%}
            <span class="mc-caps" style="color:var(--mc-text-muted)">{{ paginate.current_page }} / {{ paginate.pages }}</span>
            {%- if paginate.next -%}<a class="mc-link-gold" href="{{ paginate.next.url }}">{{ 'general.next' | t | default: 'Next' }} &rarr;</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <p class="mc-lead" style="text-align:center">The library is being filled. Return soon.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Articles per page", "min": 6, "max": 24, "step": 3, "default": 9 }
  ],
  "enabled_on": { "templates": ["blog"] }
}
{% endschema %}
