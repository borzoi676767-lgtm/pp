<section class="mc-section">
  <div class="mc-container">
    <div class="mc-product">
      {%- comment -%} Gallery — image / video / 3D model {%- endcomment -%}
      <div class="mc-product__gallery" data-mc-gallery>
        <div class="mc-product__stage">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="mc-media-slide" data-index="{{ forloop.index0 }}"{% unless forloop.first %} hidden{% endunless %}>
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    {{ media | image_url: width: 1200 | image_tag:
                       loading: forloop.first, fetchpriority: 'high', widths: '500,750,1000,1200',
                       sizes: '(min-width:900px) 50vw, 100vw', alt: media.alt | default: product.title }}
                  {%- when 'video' -%}
                    <span class="mc-media-badge">{{ 'products.video' | t | default: 'Video' }}</span>
                    {{ media | video_tag: image_size: '1200x', controls: true, loop: true, muted: true }}
                  {%- when 'external_video' -%}
                    <span class="mc-media-badge">{{ 'products.video' | t | default: 'Video' }}</span>
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    <span class="mc-media-badge">{{ 'products.model' | t | default: '3D · drag to rotate' }}</span>
                    {{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}
                  {%- else -%}
                    {{ media | image_url: width: 1200 | image_tag: loading: 'lazy', alt: product.title }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="mc-media-slide" data-index="0">{% render 'placeholder', label: product.title %}</div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="mc-product__thumbs">
            {%- for media in product.media limit: 8 -%}
              <button type="button" data-mc-thumb="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                      aria-label="{{ 'products.view_image' | t | default: 'View image' }} {{ forloop.index }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: product.title }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Info {%- endcomment -%}
      <div class="mc-product__info">
        {%- if product.vendor != blank -%}<p class="mc-eyebrow">{{ product.vendor }}</p>{%- endif -%}
        <h1 class="mc-h2">{{ product.title }}</h1>
        <div class="mc-product__price">
          <span data-mc-price-current>{{ product.selected_or_first_available_variant.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <s style="color:var(--mc-text-muted);font-size:1rem">{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        </div>

        {%- form 'product', product, class: 'mc-stack', data-mc-add-form: 'true' -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="mc-variant">
                <label for="mc-opt-{{ forloop.index }}">{{ option.name }}</label>
                <select id="mc-opt-{{ forloop.index }}" name="options[{{ option.name | escape }}]">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <select name="id" class="mc-visually-hidden" aria-hidden="true" tabindex="-1">
            {%- for variant in product.variants -%}
              <option value="{{ variant.id }}"{% if variant == product.selected_or_first_available_variant %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>{{ variant.title }}</option>
            {%- endfor -%}
          </select>

          <button type="submit" name="add" class="mc-btn mc-btn--full" {% unless product.available %}disabled{% endunless %}
            data-mc-add-btn
            data-add-label="{{ 'products.add_to_cart' | t | default: 'Add to cart' }}"
            data-sold-label="{{ 'products.sold_out' | t | default: 'Sold out' }}">
            {%- if product.available -%}{{ 'products.add_to_cart' | t | default: 'Add to cart' }}{%- else -%}{{ 'products.sold_out' | t | default: 'Sold out' }}{%- endif -%}
          </button>

          <script type="application/json" data-mc-variants>[
            {%- for v in product.variants -%}
              {"id": {{ v.id }}, "options": {{ v.options | json }}, "available": {{ v.available }}, "price": {{ v.price | money | json }}}{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]</script>
        {%- endform -%}

        {%- comment -%} Merchant-configurable info blocks {%- endcomment -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'description' -%}
              <div class="mc-product__desc rte" {{ block.shopify_attributes }}>{{ product.description }}</div>

            {%- when 'provenance' -%}
              {%- assign body = product.metafields.custom.materials | default: block.settings.text -%}
              {%- if body != blank -%}
                <details class="mc-accordion" {{ block.shopify_attributes }}{% if block.settings.open %} open{% endif %}>
                  <summary>{% render 'icon', name: 'chi-rho', size: 18 %} {{ block.settings.heading }}</summary>
                  <div class="rte" style="padding-top:8px">{{ body }}</div>
                </details>
              {%- endif -%}

            {%- when 'care' -%}
              {%- assign body = product.metafields.custom.care | default: block.settings.text -%}
              {%- if body != blank -%}
                <details class="mc-accordion" {{ block.shopify_attributes }}>
                  <summary>{% render 'icon', name: 'olive', size: 18 %} {{ block.settings.heading }}</summary>
                  <div class="rte" style="padding-top:8px">{{ body }}</div>
                </details>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <details class="mc-accordion" {{ block.shopify_attributes }}>
                  <summary>{{ block.settings.heading }}</summary>
                  <div class="rte" style="padding-top:8px">{{ block.settings.text }}</div>
                </details>
              {%- endif -%}

            {%- when 'heraldry' -%}
              <div class="mc-heraldry" {{ block.shopify_attributes }}>
                <span class="mc-heraldry__seal">{% render 'icon', name: 'chi-rho', size: 34 %}</span>
                <p>{{ block.settings.text }}</p>
              </div>

            {%- when 'share' -%}
              <div class="mc-share" {{ block.shopify_attributes }}>
                <span class="mc-eyebrow">{{ 'products.share' | t | default: 'Share' }}</span>
                <a class="mc-link-gold" href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ product.url }}" target="_blank" rel="noopener">Facebook</a>
                <a class="mc-link-gold" href="https://x.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}" target="_blank" rel="noopener">X</a>
                <a class="mc-link-gold" href="mailto:?subject={{ product.title | url_encode }}&body={{ shop.url }}{{ product.url }}">Email</a>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Load model-viewer only when the product has a 3D model {%- endcomment -%}
  {%- assign has_model = false -%}
  {%- for media in product.media -%}{%- if media.media_type == 'model' -%}{%- assign has_model = true -%}{%- break -%}{%- endif -%}{%- endfor -%}
  {%- if has_model -%}
    <script src="{{ 'shopify_common.js' | shopify_asset_url }}" defer></script>
    <script>
      window.addEventListener('load', function () {
        if (window.Shopify && Shopify.loadFeatures) {
          Shopify.loadFeatures([{ name: 'model-viewer-ui', version: '1.0', onLoad: function () {} }]);
        }
      });
    </script>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "blocks": [
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "provenance", "name": "Provenance & materials", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Provenance & materials" },
      { "type": "richtext", "id": "text", "label": "Fallback text", "info": "Used when the product has no custom.materials metafield." },
      { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
    ] },
    { "type": "care", "name": "Care", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Care" },
      { "type": "richtext", "id": "text", "label": "Fallback text", "info": "Used when the product has no custom.care metafield." }
    ] },
    { "type": "text", "name": "Text accordion", "settings": [
      { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
      { "type": "richtext", "id": "text", "label": "Text" }
    ] },
    { "type": "heraldry", "name": "Heraldry seal", "settings": [
      { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Marked with an original Milites Christi heraldic seal — inspired by tradition, drawn anew.</p>" }
    ] },
    { "type": "share", "name": "Share", "limit": 1 }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
