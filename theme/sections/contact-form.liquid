<section class="mc-section mc-scheme--{{ section.settings.scheme }}">
  <div class="mc-container mc-container--narrow" style="max-width:640px">
    {%- if section.settings.heading != blank -%}
      <header class="mc-section__head">
        <h2 class="mc-h2">{{ section.settings.heading }}</h2>
        {%- if section.settings.subtext != blank -%}<p class="mc-lead">{{ section.settings.subtext }}</p>{%- endif -%}
        <hr class="mc-rule">
      </header>
    {%- endif -%}

    {%- form 'contact', class: 'mc-stack' -%}
      {%- if form.posted_successfully? -%}
        <p class="mc-eyebrow" role="status" style="margin-bottom:16px">{{ 'contact.success' | t | default: 'Thank you — we will reply soon.' }}</p>
      {%- endif -%}
      {{ form.errors | default_errors }}
      <div class="mc-field">
        <label for="contact_name">{{ 'contact.name' | t | default: 'Name' }}</label>
        <input type="text" id="contact_name" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
      </div>
      <div class="mc-field">
        <label for="contact_email">{{ 'contact.email' | t | default: 'Email' }}</label>
        <input type="email" id="contact_email" name="contact[email]" autocomplete="email" required value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}">
      </div>
      <div class="mc-field">
        <label for="contact_body">{{ 'contact.message' | t | default: 'Message' }}</label>
        <textarea id="contact_body" name="contact[body]" rows="6" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
      </div>
      <button type="submit" class="mc-btn">{{ 'contact.send' | t | default: 'Send message' }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "select", "id": "scheme", "label": "Color scheme", "options": [
      { "value": "basilica", "label": "Basilica (dark)" }, { "value": "parchment", "label": "Parchment (light)" }
    ], "default": "basilica" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send word" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Questions on a piece, an order, or a commission — we read every message." }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
