{%- if section.settings.text != blank -%}
  <div class="mc-announce">
    <div class="mc-announce__inner">
      {%- if section.settings.show_symbol -%}{% render 'icon', name: 'chi-rho', size: 16 %}{%- endif -%}
      <span>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
        {%- else -%}
          {{ section.settings.text | escape }}
        {%- endif -%}
      </span>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on heirloom orders over $150" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "show_symbol", "label": "Show Chi-Rho symbol", "default": true }
  ],
  "presets": [{ "name": "Announcement bar" }]
}
{% endschema %}
