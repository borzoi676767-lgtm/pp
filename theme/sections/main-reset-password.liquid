<section class="mc-section">
  <div class="mc-container mc-container--narrow" style="max-width:520px">
    <header class="mc-section__head">
      <p class="mc-eyebrow">{% render 'icon', name: 'chi-rho', size: 20 %}</p>
      <h1 class="mc-h2">{{ 'customer.reset_password.title' | t | default: 'Reset your password' }}</h1>
      <hr class="mc-rule">
    </header>

    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="mc-stack">
        <div class="mc-field">
          <label for="password">{{ 'customer.reset_password.new' | t | default: 'New password' }}</label>
          <input type="password" name="customer[password]" id="password" autocomplete="new-password" required>
        </div>
        <div class="mc-field">
          <label for="password_confirmation">{{ 'customer.reset_password.confirm' | t | default: 'Confirm password' }}</label>
          <input type="password" name="customer[password_confirmation]" id="password_confirmation" autocomplete="new-password" required>
        </div>
        <button type="submit" class="mc-btn mc-btn--full">{{ 'customer.reset_password.submit' | t | default: 'Reset password' }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [], "enabled_on": { "templates": ["customers/reset_password"] } }
{% endschema %}
