<section class="mc-section">
  <div class="mc-container">
    <header class="mc-section__head">
      <p class="mc-eyebrow">{{ 'customer.order.title' | t | default: 'Order' }} {{ order.name }}</p>
      <h1 class="mc-h2">{{ order.created_at | date: '%B %e, %Y' }}</h1>
      <hr class="mc-rule">
      <a class="mc-link-gold mc-caps" href="{{ routes.account_url }}">&larr; {{ 'customer.order.back' | t | default: 'Back to account' }}</a>
    </header>

    <div style="overflow-x:auto">
      <table style="width:100%;border-collapse:collapse;min-width:640px">
        <thead>
          <tr style="text-align:left;border-bottom:1px solid var(--mc-border)">
            <th class="mc-eyebrow" style="padding:12px 8px">{{ 'customer.order.product' | t | default: 'Product' }}</th>
            <th class="mc-eyebrow" style="padding:12px 8px">{{ 'customer.order.price' | t | default: 'Price' }}</th>
            <th class="mc-eyebrow" style="padding:12px 8px">{{ 'customer.order.quantity' | t | default: 'Qty' }}</th>
            <th class="mc-eyebrow" style="padding:12px 8px">{{ 'customer.order.total' | t | default: 'Total' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for line_item in order.line_items -%}
            <tr style="border-bottom:1px solid var(--mc-border)">
              <td style="padding:12px 8px"><a class="mc-link-gold" href="{{ line_item.product.url }}">{{ line_item.title }}</a></td>
              <td style="padding:12px 8px">{{ line_item.price | money }}</td>
              <td style="padding:12px 8px">{{ line_item.quantity }}</td>
              <td style="padding:12px 8px">{{ line_item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
        <tfoot>
          <tr><td colspan="3" style="padding:12px 8px;text-align:right" class="mc-caps">{{ 'customer.order.subtotal' | t | default: 'Subtotal' }}</td><td style="padding:12px 8px">{{ order.line_items_subtotal_price | money }}</td></tr>
          {%- for shipping_method in order.shipping_methods -%}
            <tr><td colspan="3" style="padding:12px 8px;text-align:right" class="mc-caps">{{ 'customer.order.shipping' | t | default: 'Shipping' }} ({{ shipping_method.title }})</td><td style="padding:12px 8px">{{ shipping_method.price | money }}</td></tr>
          {%- endfor -%}
          {%- for tax_line in order.tax_lines -%}
            <tr><td colspan="3" style="padding:12px 8px;text-align:right" class="mc-caps">{{ 'customer.order.tax' | t | default: 'Tax' }} ({{ tax_line.title }})</td><td style="padding:12px 8px">{{ tax_line.price | money }}</td></tr>
          {%- endfor -%}
          <tr><td colspan="3" style="padding:12px 8px;text-align:right" class="mc-caps"><strong>{{ 'customer.order.total' | t | default: 'Total' }}</strong></td><td style="padding:12px 8px"><strong class="mc-product__price" style="font-size:1.2rem">{{ order.total_net_amount | money }}</strong></td></tr>
        </tfoot>
      </table>
    </div>

    <div class="mc-grid mc-grid--2" style="margin-top:40px">
      <div>
        <h2 class="mc-eyebrow">{{ 'customer.order.billing' | t | default: 'Billing address' }}</h2>
        <div class="rte" style="color:var(--mc-text-muted);margin-top:8px">{{ order.billing_address | format_address }}</div>
      </div>
      <div>
        <h2 class="mc-eyebrow">{{ 'customer.order.shipping_address' | t | default: 'Shipping address' }}</h2>
        <div class="rte" style="color:var(--mc-text-muted);margin-top:8px">{{ order.shipping_address | format_address }}</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Order", "settings": [], "enabled_on": { "templates": ["customers/order"] } }
{% endschema %}
