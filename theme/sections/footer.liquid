<footer class="mc-footer">
  <div class="mc-container">
    <div class="mc-footer__grid">
      <div>
        <a class="mc-header__brand" href="{{ routes.root_url }}" style="margin-bottom:16px">
          {% render 'icon', name: 'chi-rho', size: 28 %}<span>{{ shop.name }}</span>
        </a>
        <p class="mc-footer__motto">{{ shop.metafields.custom.motto | default: section.settings.motto }}</p>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul role="list">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div>
        <h4>{{ section.settings.newsletter_heading }}</h4>
        <p style="color:var(--mc-text-muted);margin-bottom:12px">{{ section.settings.newsletter_text }}</p>
        {%- form 'customer', class: 'mc-newsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="mc-visually-hidden" for="mc-newsletter">{{ 'newsletter.email' | t | default: 'Email' }}</label>
          <input id="mc-newsletter" type="email" name="contact[email]" placeholder="you@example.com" required>
          <button type="submit" class="mc-btn">{{ 'newsletter.subscribe' | t | default: 'Join' }}</button>
          {%- if form.posted_successfully? -%}<p class="mc-eyebrow">{{ 'newsletter.success' | t | default: 'Welcome, pilgrim.' }}</p>{%- endif -%}
        {%- endform -%}
      </div>
    </div>

    <div class="mc-footer__base">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights }}</span>
      <span class="mc-motto">{{ 'general.closing_line' | t | default: 'Earthly empires rise and fall, but the Kingdom of Christ endures forever.' }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "motto", "label": "Motto", "default": "Earthly empires rise and fall, but the Kingdom of Christ endures forever." },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Join the Order" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter text", "default": "Word from the workshop: new pieces, and notes on faith and history." },
    { "type": "text", "id": "rights", "label": "Rights text", "default": "All rights reserved." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Faith & History" } }
      ]
    }
  ]
}
{% endschema %}
