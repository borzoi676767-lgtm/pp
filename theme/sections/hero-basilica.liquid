<section class="mc-hero mc-scheme--basilica mc-vignette">
  <div class="mc-hero__media mc-parallax" data-mc-parallax="0.14">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag:
         loading: 'eager', fetchpriority: 'high', widths: '750,1100,1500,2000,2400',
         sizes: '100vw', alt: section.settings.image.alt | default: shop.name }}
    {%- else -%}
      {% render 'placeholder', label: 'Basilica hero' %}
    {%- endif -%}
  </div>
  <div class="mc-hero__scrim"></div>
  {%- if settings.enable_particles -%}<div class="mc-particles" aria-hidden="true"></div>{%- endif -%}

  <div class="mc-container">
    <div class="mc-hero__inner">
      {%- if section.settings.eyebrow != blank -%}<p class="mc-eyebrow mc-reveal">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="mc-hero__title mc-reveal" data-delay="1">{{ section.settings.heading | default: 'Milites Christi' }}</h1>
      {%- if section.settings.subheading != blank -%}<p class="mc-hero__sub mc-reveal" data-delay="2">{{ section.settings.subheading }}</p>{%- endif -%}
      <div class="mc-hero__cta mc-reveal" data-delay="3">
        {%- if section.settings.cta_text != blank -%}<a class="mc-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>{%- endif -%}
        {%- if section.settings.cta2_text != blank -%}<a class="mc-btn mc-btn--ghost" href="{{ section.settings.cta2_link }}">{{ section.settings.cta2_text }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero — Basilica",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Black-marble basilica, candlelight, Chi-Rho banners. Warm, monumental." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Soldiers of Christ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A living Christian civilization" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Heirloom goods drawn from the beauty of Rome, Byzantium, and Christian Europe — refined and dedicated to the glory of God." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Enter the collections" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "Our story" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" }
  ],
  "presets": [{ "name": "Hero — Basilica" }]
}
{% endschema %}
