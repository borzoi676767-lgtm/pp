<div class="mc-password">
  <div style="color:var(--mc-accent)">{% render 'icon', name: 'chi-rho', size: 56 %}</div>
  <p class="mc-eyebrow">{{ shop.metafields.custom.tagline | default: 'Soldiers of Christ' }}</p>
  <h1 class="mc-h1">{{ shop.name }}</h1>

  {%- if shop.password_message != blank -%}
    <div class="mc-lead rte">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="mc-lead">{{ 'password.coming_soon' | t | default: 'Opening soon. The workshop is preparing.' }}</p>
  {%- endif -%}

  {%- comment -%} Email capture {%- endcomment -%}
  {%- form 'customer', class: 'mc-newsletter', style: 'margin-inline:auto' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    <label class="mc-visually-hidden" for="mc-password-email">{{ 'newsletter.email' | t | default: 'Email' }}</label>
    <input id="mc-password-email" type="email" name="contact[email]" placeholder="you@example.com" required>
    <button type="submit" class="mc-btn">{{ 'password.notify' | t | default: 'Notify me' }}</button>
    {%- if form.posted_successfully? -%}<p class="mc-eyebrow" style="width:100%">{{ 'newsletter.success' | t | default: 'Welcome, pilgrim.' }}</p>{%- endif -%}
  {%- endform -%}

  {%- comment -%} Storefront password entry {%- endcomment -%}
  <details style="margin-top:var(--mc-sp-4)">
    <summary class="mc-link-gold" style="cursor:pointer">{{ 'password.enter' | t | default: 'Enter using password' }}</summary>
    {%- form 'storefront_password', class: 'mc-newsletter', style: 'margin:16px auto 0' -%}
      {{ form.errors | default_errors }}
      <label class="mc-visually-hidden" for="mc-storefront-password">{{ 'password.password' | t | default: 'Password' }}</label>
      <input type="password" id="mc-storefront-password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t | default: 'Password' }}" required>
      <button type="submit" class="mc-btn mc-btn--ghost">{{ 'password.submit' | t | default: 'Enter' }}</button>
    {%- endform -%}
  </details>

  <p class="mc-password__foot">{{ powered_by_link }}</p>
</div>

{% schema %}
{ "name": "Password", "settings": [], "enabled_on": { "templates": ["password"] } }
{% endschema %}
