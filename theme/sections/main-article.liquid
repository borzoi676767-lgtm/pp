<article class="mc-section">
  <div class="mc-container mc-container--narrow">
    <header class="mc-section__head">
      <p class="mc-eyebrow">{{ article.published_at | date: '%B %e, %Y' }}{% if article.author != blank %} &middot; {{ article.author }}{% endif %}</p>
      <h1 class="mc-h1">{{ article.title }}</h1>
      <hr class="mc-rule">
    </header>

    {%- if article.image -%}
      <div class="mc-mediatext__media mc-reveal" style="aspect-ratio:16/9;margin-bottom:40px">
        {{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600,900,1200,1600', sizes: '(min-width:900px) 900px, 100vw', alt: article.title }}
      </div>
    {%- endif -%}

    <div class="mc-prose rte">
      {{ article.content }}
    </div>

    {%- if section.settings.show_share -%}
      <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--mc-border)">
        <span class="mc-eyebrow">Share</span>
        <div style="display:flex;gap:16px;margin-top:8px">
          <a class="mc-link-gold" href="https://www.facebook.com/sharer.php?u={{ shop.url }}{{ article.url }}" target="_blank" rel="noopener">Facebook</a>
          <a class="mc-link-gold" href="https://x.com/intent/tweet?url={{ shop.url }}{{ article.url }}&text={{ article.title | url_encode }}" target="_blank" rel="noopener">X</a>
          <a class="mc-link-gold" href="mailto:?subject={{ article.title | url_encode }}&body={{ shop.url }}{{ article.url }}">Email</a>
        </div>
      </div>
    {%- endif -%}

    <div style="margin-top:40px;text-align:center">
      <a class="mc-btn mc-btn--ghost" href="{{ blog.url }}">{% render 'icon', name: 'arrow', size: 18 %} Back to the Library</a>
    </div>

    {%- if blog.comments_enabled? -%}
      <section style="margin-top:56px" aria-label="Comments">
        {%- if article.comments_count > 0 -%}
          <h2 class="mc-h3" style="margin-bottom:24px">{{ article.comments_count }} reflections</h2>
          {%- for comment in article.comments -%}
            <div style="padding-block:16px;border-bottom:1px solid var(--mc-border)">
              <div class="rte">{{ comment.content }}</div>
              <p class="mc-eyebrow" style="color:var(--mc-text-muted);margin-top:8px">— {{ comment.author }}</p>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </section>
    {%- endif -%}
  </div>
</article>

{% schema %}
{
  "name": "Article",
  "settings": [
    { "type": "checkbox", "id": "show_share", "label": "Show share links", "default": true }
  ],
  "enabled_on": { "templates": ["article"] }
}
{% endschema %}
