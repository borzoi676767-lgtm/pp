{%- comment -%}
  Icon system. Usage: {% render 'icon', name: 'chi-rho' %}
  Params: name (required), size (optional, default 24)
  Icons use currentColor so they inherit text color.
{%- endcomment -%}
{%- liquid
  assign s = size | default: 24
-%}
{%- case name -%}
  {%- when 'chi-rho' -%}
    {%- comment -%} Solid carved Chi-Rho: tapered Chi arms, Rho stem with serif terminals, closed bowl. {%- endcomment -%}
    <svg viewBox="0 0 100 100" width="{{ s }}" height="{{ s }}" fill="currentColor" aria-hidden="true" focusable="false">
      {%- comment -%} Chi (X) — thick carved arms {%- endcomment -%}
      <path d="M19 22 L28 14 L84 70 L75 78 Z"/>
      <path d="M81 22 L72 14 L16 70 L25 78 Z"/>
      {%- comment -%} Rho — stem with a flared base serif {%- endcomment -%}
      <path d="M44 7 h12 v83 h-12 Z"/>
      <path d="M32 84 h36 v9 h-36 Z"/>
      {%- comment -%} Rho — closed bowl {%- endcomment -%}
      <path d="M52 7 h9 a18.5 18.5 0 0 1 0 37 h-9 v-9 h9 a9.5 9.5 0 0 0 0-19 h-9 Z"/>
    </svg>
  {%- when 'cross' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="12" y1="3" x2="12" y2="21"/><line x1="6" y1="9" x2="18" y2="9"/></svg>
  {%- when 'olive' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 20c6-1 12-6 16-16"/><path d="M13 7c2-1 4-1 6-2M11 11c2 0 4 1 6 1M9 15c2 1 3 2 4 4"/></svg>
  {%- when 'laurel' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 21c-4-2-6-6-6-11M12 21c4-2 6-6 6-11"/><path d="M6 6c1 1 2 1 3 0M7 10c1 1 2 1 3 0M18 6c-1 1-2 1-3 0M17 10c-1 1-2 1-3 0"/></svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3l7 3v5c0 5-3 8-7 10-4-2-7-5-7-10V6z"/><path d="M12 8v6M9.5 11h5"/></svg>
  {%- when 'crown' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 8l3 9h10l3-9-5 4-3-6-3 6z"/></svg>
  {%- when 'book' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 5C10 3.5 6.5 3.5 4 4v14c2.5-.5 6-.5 8 1 2-1.5 5.5-1.5 8-1V4c-2.5-.5-6-.5-8 1z"/><line x1="12" y1="5" x2="12" y2="20"/></svg>
  {%- when 'lamp' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 3h6l-1 5a3 3 0 01-4 0z"/><line x1="12" y1="9" x2="12" y2="17"/><path d="M8 21h8"/><path d="M10 17h4l-1 4h-2z"/></svg>
  {%- comment -%} ---- Roman architecture ---- {%- endcomment -%}
  {%- when 'column' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 4h14M6 7h12M8 7v10M11 7v10M13 7v10M16 7v10M6 17h12M5 20h14"/></svg>
  {%- when 'arch' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 21V12a8 8 0 0 1 16 0v9"/><path d="M8 21v-9a4 4 0 0 1 8 0v9"/><path d="M2 21h20"/></svg>
  {%- when 'temple' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 9 12 3l10 6"/><path d="M4 9v10M9 9v10M15 9v10M20 9v10"/><path d="M2 21h20"/></svg>
  {%- when 'aqueduct' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M2 6h20M2 10h20"/><path d="M5 10v11M12 10v11M19 10v11"/><path d="M5 21a3.5 3.5 0 0 1 7 0M12 21a3.5 3.5 0 0 1 7 0"/></svg>

  {%- comment -%} ---- Catholic / devotional ---- {%- endcomment -%}
  {%- when 'chalice' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 4h12a6 6 0 0 1-6 7 6 6 0 0 1-6-7z"/><path d="M12 11v6"/><path d="M8 20h8"/><path d="M9 20a3 3 0 0 1 6 0"/></svg>
  {%- when 'crucifix' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2v20M6 8h12"/><path d="M10 2h4"/></svg>
  {%- when 'dove' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 6c-3 0-5 1-7 4-1.5 2.2-3.5 3.5-6 3.5"/><path d="M7 13.5c1 3 3.5 5 7 5 3 0 5-2 5-5"/><path d="M20 6l2-1-1 2.5"/><path d="M11 18.5 9 22"/></svg>
  {%- when 'rosary' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="9" r="6"/><circle cx="12" cy="3.2" r="1"/><circle cx="6.2" cy="9" r="1"/><circle cx="17.8" cy="9" r="1"/><path d="M12 15v3M10 21h4M12 18v3"/></svg>
  {%- when 'stained-glass' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 21V10a7 7 0 0 1 14 0v11z"/><path d="M12 3v18M5 13h14"/></svg>

  {%- comment -%} ---- Military / order ---- {%- endcomment -%}
  {%- when 'standard' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2v20"/><path d="M12 4h7l-2 3 2 3h-7"/><path d="M8 22h8"/><path d="M9 2h6"/></svg>
  {%- when 'eagle' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 7v9"/><path d="M12 8 4 5c1 4 3.5 6 8 7M12 8l8-3c-1 4-3.5 6-8 7"/><path d="M10 20h4M12 16v4"/></svg>
  {%- when 'helmet' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 13a7 7 0 0 1 14 0v4a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3z"/><path d="M12 2c1.5 0 2.5 2 2.5 4.5S13.5 11 12 11"/><path d="M9 20v-4M15 20v-4"/></svg>
  {%- when 'gladius' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 2 14 6v8h-4V6z"/><path d="M8 16h8"/><path d="M12 16v6"/><path d="M10 22h4"/></svg>

  {%- when 'anchor-cross' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="12" y1="3" x2="12" y2="19"/><line x1="8" y1="7" x2="16" y2="7"/><path d="M5 14a7 7 0 0014 0"/></svg>
  {%- when 'cart' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 5h2l1.5 11h10L20 8H7"/><circle cx="9" cy="20" r="1"/><circle cx="17" cy="20" r="1"/></svg>
  {%- when 'search' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><line x1="16" y1="16" x2="21" y2="21"/></svg>
  {%- when 'menu' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
  {%- when 'close' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" focusable="false"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
  {%- when 'arrow' -%}
    <svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="14 6 20 12 14 18"/></svg>
  {%- else -%}
    <svg viewBox="0 0 48 48" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <line x1="11" y1="13" x2="37" y2="37"/><line x1="37" y1="13" x2="11" y2="37"/><line x1="24" y1="5" x2="24" y2="43"/><path d="M24 5h4.5a7.5 7.5 0 0 1 0 15H24"/>
    </svg>
{%- endcase -%}
