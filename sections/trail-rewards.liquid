{%- comment -%}
  Trail Rewards — the camp loyalty / badges program page.
  Explains how members earn badges (ties into the in-theme bean hunt),
  the membership tiers, and the perks. Self-contained & themed.
{%- endcomment -%}
<section id="shopify-section-{{ section.id }}" class="tr" aria-label="Trail Rewards">
  <div class="page-width">

    <header class="tr__head" data-reveal>
      {%- if section.settings.eyebrow != blank -%}<p class="tr__eyebrow">{% render 'icon', name: 'compass', size: 16 %} {{ section.settings.eyebrow }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="tr__title">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="tr__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
      <div class="tr__cta-row">
        <a class="btn btn--accent btn--lg" href="{{ section.settings.join_url | default: '#join' }}">{% render 'icon', name: 'gift', size: 18 %} {{ section.settings.join_label | default: "Join the Camp — it's free" }}</a>
        <a class="btn btn--ghost btn--lg" href="{{ routes.all_products_collection_url }}">Start earning</a>
      </div>
    </header>

    {%- comment -%} ---------------- How it works ---------------- {%- endcomment -%}
    <div class="tr__steps" data-reveal>
      <div class="tr__step"><span class="tr__step-n">1</span><h3>Join the camp</h3><p>Create an account or sign up for trail dispatches. That's your trailhead — no cost, no catch.</p></div>
      <div class="tr__step"><span class="tr__step-n">2</span><h3>Explore &amp; collect</h3><p>Shop small-batch roasts, read our stories, and hunt the coffee beans hidden around the forest to unlock camp badges.</p></div>
      <div class="tr__step"><span class="tr__step-n">3</span><h3>Earn your perks</h3><p>The more you explore, the more you unlock — early access to new roasts, members-only drops, and a birthday treat.</p></div>
    </div>

    {%- comment -%} ---------------- Camp badges ---------------- {%- endcomment -%}
    <div class="tr__badges-wrap" data-reveal>
      <h2 class="tr__h2">Collect the Camp Badges</h2>
      <p class="tr__sub">Five badges hide across the site. Find the beans, tap them, and light up your tray — the crew notices the collectors.</p>
      <div class="tr__badges">
        {%- assign badge_emojis = '☕,🎒,📖,🦉,🫘' | split: ',' -%}
        {%- assign badge_names = 'First Brew,Trail Collector,Story Seeker,Night Owl,Bean Hunter' | split: ',' -%}
        {%- assign badge_hows = 'Place your first order,Browse four collections,Open our campfire story,Visit after dark,Find every hidden bean' | split: ',' -%}
        {%- for e in badge_emojis -%}
          <div class="tr__badge">
            <div class="tr__badge-ic" aria-hidden="true">{{ e }}</div>
            <h4>{{ badge_names[forloop.index0] }}</h4>
            <p>{{ badge_hows[forloop.index0] }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---------------- Tiers ---------------- {%- endcomment -%}
    <div class="tr__tiers" data-reveal>
      <h2 class="tr__h2">Climb the Trail</h2>
      <p class="tr__sub">Every tier opens up more of the camp. You move up just by being around the fire.</p>
      <div class="tr__tier-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'tier' -%}
          <div class="tr__tier{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.featured -%}<span class="tr__tier-flag">Most loved</span>{%- endif -%}
            <div class="tr__tier-ic">{% render 'icon', name: block.settings.icon, size: 26 %}</div>
            <h3>{{ block.settings.name }}</h3>
            {%- if block.settings.threshold != blank -%}<p class="tr__tier-req">{{ block.settings.threshold }}</p>{%- endif -%}
            <ul class="tr__perks">
              {%- assign perks = block.settings.perks | newline_to_br | split: '<br />' -%}
              {%- for perk in perks -%}
                {%- assign perk_t = perk | strip -%}
                {%- if perk_t != blank -%}<li>{% render 'icon', name: 'check', size: 15 %} {{ perk_t }}</li>{%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} ---------------- Join CTA ---------------- {%- endcomment -%}
    <div id="join" class="tr__join" data-reveal>
      <div class="tr__join-inner">
        <h2 class="tr__h2" style="margin-top:0">{{ section.settings.join_heading | default: 'Ready to find your trail?' }}</h2>
        <p class="tr__sub">{{ section.settings.join_text | default: 'Sign up for trail dispatches and start collecting from your very first cup.' }}</p>
        {%- form 'customer', class: 'tr__form' -%}
          <input type="hidden" name="contact[tags]" value="rewards">
          <div class="tr__form-row">
            <input class="input" type="email" name="contact[email]" placeholder="you@trailmail.com" aria-label="Email address" required>
            <button type="submit" class="btn btn--gold btn--lg">Join the Camp</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="tr__ok">You're in — welcome to camp. Keep an eye on your inbox.</p>{%- endif -%}
          {%- if form.errors -%}<p class="tr__err">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
        <p class="tr__fine">Free to join. Unsubscribe any time. We only send the good stuff.</p>
      </div>
    </div>

  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .tr { padding-block: clamp(2.4rem, 6vw, 4.5rem); }
  #shopify-section-{{ section.id }} .tr__head { text-align: center; max-width: 62ch; margin: 0 auto clamp(2rem,5vw,3.4rem); }
  #shopify-section-{{ section.id }} .tr__eyebrow { display:inline-flex; align-items:center; gap:.4rem; font-size:.78rem; letter-spacing:.14em; text-transform:uppercase; font-weight:800; color:var(--accent); }
  #shopify-section-{{ section.id }} .tr__title { font-size: clamp(2rem, 5vw, 3.2rem); margin: .4rem 0 .6rem; text-wrap: balance; }
  #shopify-section-{{ section.id }} .tr__intro { color: var(--ink-soft); font-size: 1.08rem; line-height: 1.6; }
  #shopify-section-{{ section.id }} .tr__cta-row { display:flex; gap:.7rem; justify-content:center; flex-wrap:wrap; margin-top:1.4rem; }

  #shopify-section-{{ section.id }} .tr__steps { display:grid; grid-template-columns:repeat(3,1fr); gap:1.2rem; margin-bottom: clamp(2.4rem,6vw,4rem); }
  #shopify-section-{{ section.id }} .tr__step { position:relative; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-lg); padding:1.6rem 1.4rem 1.4rem; box-shadow:var(--shadow-sm); }
  #shopify-section-{{ section.id }} .tr__step-n { position:absolute; top:-16px; left:1.4rem; width:34px; height:34px; border-radius:50%; display:grid; place-items:center; background:var(--forest-700); color:var(--gold-400); font-family:var(--font-head); font-weight:800; box-shadow:var(--shadow-sm); }
  #shopify-section-{{ section.id }} .tr__step h3 { margin:.6rem 0 .4rem; font-size:1.15rem; }
  #shopify-section-{{ section.id }} .tr__step p { margin:0; color:var(--ink-soft); font-size:.95rem; line-height:1.55; }

  #shopify-section-{{ section.id }} .tr__h2 { font-size: clamp(1.5rem,3.2vw,2.2rem); text-align:center; margin:0 0 .3rem; }
  #shopify-section-{{ section.id }} .tr__sub { text-align:center; color:var(--ink-soft); max-width:54ch; margin:0 auto 1.8rem; }

  #shopify-section-{{ section.id }} .tr__badges-wrap { margin-bottom: clamp(2.4rem,6vw,4rem); }
  #shopify-section-{{ section.id }} .tr__badges { display:grid; grid-template-columns:repeat(5,1fr); gap:1rem; }
  #shopify-section-{{ section.id }} .tr__badge { text-align:center; background:radial-gradient(120% 130% at 50% 0%, var(--surface), var(--surface-2)); border:1px solid var(--line); border-radius:var(--r-lg); padding:1.4rem 1rem; box-shadow:var(--shadow-sm); }
  #shopify-section-{{ section.id }} .tr__badge-ic { font-size:2.4rem; line-height:1; margin-bottom:.5rem; filter:drop-shadow(0 4px 8px rgba(0,0,0,.18)); }
  #shopify-section-{{ section.id }} .tr__badge h4 { margin:.2rem 0 .3rem; font-size:1rem; }
  #shopify-section-{{ section.id }} .tr__badge p { margin:0; font-size:.82rem; color:var(--ink-mute); }

  #shopify-section-{{ section.id }} .tr__tiers { margin-bottom: clamp(2.4rem,6vw,4rem); }
  #shopify-section-{{ section.id }} .tr__tier-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.2rem; align-items:stretch; }
  #shopify-section-{{ section.id }} .tr__tier { position:relative; background:var(--surface); border:1px solid var(--line); border-radius:var(--r-lg); padding:1.8rem 1.5rem; box-shadow:var(--shadow-sm); display:flex; flex-direction:column; }
  #shopify-section-{{ section.id }} .tr__tier.is-featured { border-color:var(--gold-500); box-shadow:0 0 0 2px rgba(242,193,78,.4), var(--shadow-md); }
  #shopify-section-{{ section.id }} .tr__tier-flag { position:absolute; top:-12px; left:50%; transform:translateX(-50%); background:var(--gold-500); color:var(--forest-900,#16321f); font-size:.7rem; font-weight:800; letter-spacing:.06em; text-transform:uppercase; padding:.25rem .7rem; border-radius:var(--r-pill); white-space:nowrap; }
  #shopify-section-{{ section.id }} .tr__tier-ic { width:56px; height:56px; border-radius:50%; display:grid; place-items:center; background:var(--forest-700); color:var(--gold-400); margin-bottom:.8rem; }
  #shopify-section-{{ section.id }} .tr__tier h3 { margin:0 0 .1rem; font-size:1.3rem; }
  #shopify-section-{{ section.id }} .tr__tier-req { margin:0 0 1rem; font-size:.85rem; font-weight:700; color:var(--accent); }
  #shopify-section-{{ section.id }} .tr__perks { list-style:none; margin:0; padding:0; display:grid; gap:.55rem; }
  #shopify-section-{{ section.id }} .tr__perks li { display:flex; align-items:flex-start; gap:.5rem; font-size:.92rem; color:var(--ink-soft); line-height:1.4; }
  #shopify-section-{{ section.id }} .tr__perks svg { color:var(--moss-500,var(--forest-600)); flex:0 0 auto; margin-top:.15rem; }

  #shopify-section-{{ section.id }} .tr__join { background:radial-gradient(130% 140% at 15% 0%, var(--forest-700), var(--forest-900)); border-radius:var(--r-lg); padding:clamp(2rem,5vw,3.4rem); color:var(--cream-100); }
  #shopify-section-{{ section.id }} .tr__join-inner { max-width:52ch; margin:0 auto; text-align:center; }
  #shopify-section-{{ section.id }} .tr__join .tr__h2, #shopify-section-{{ section.id }} .tr__join .tr__sub { color:var(--cream-100); }
  #shopify-section-{{ section.id }} .tr__form-row { display:flex; gap:.6rem; max-width:440px; margin:0 auto; }
  #shopify-section-{{ section.id }} .tr__form-row .input { flex:1; }
  #shopify-section-{{ section.id }} .tr__fine { font-size:.8rem; opacity:.75; margin-top:.9rem; }
  #shopify-section-{{ section.id }} .tr__ok { margin-top:.8rem; font-weight:700; color:var(--gold-400); }
  #shopify-section-{{ section.id }} .tr__err { margin-top:.8rem; color:#ffb4a2; }

  @media (max-width: 899px) {
    #shopify-section-{{ section.id }} .tr__steps, #shopify-section-{{ section.id }} .tr__tier-grid { grid-template-columns:1fr; }
    #shopify-section-{{ section.id }} .tr__badges { grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width: 560px) {
    #shopify-section-{{ section.id }} .tr__form-row { flex-direction:column; }
  }
</style>

{% schema %}
{
  "name": "Trail Rewards",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trail Rewards" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Camp Rewards You for Exploring" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Every cup, every story, every hidden bean earns you a place deeper in the forest. Join free and start collecting today.</p>" },
    { "type": "text", "id": "join_label", "label": "Top button label", "default": "Join the Camp — it's free" },
    { "type": "url", "id": "join_url", "label": "Top button link (leave blank to scroll to sign-up)" },
    { "type": "header", "content": "Join section" },
    { "type": "text", "id": "join_heading", "label": "Join heading", "default": "Ready to find your trail?" },
    { "type": "textarea", "id": "join_text", "label": "Join text", "default": "Sign up for trail dispatches and start collecting from your very first cup." }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "seed", "options": [
          {"value":"seed","label":"Bean"},{"value":"pine","label":"Pine"},{"value":"fire","label":"Fire"},{"value":"mountain","label":"Mountain"},{"value":"trophy","label":"Trophy"},{"value":"star","label":"Star"},{"value":"compass","label":"Compass"}
        ]},
        { "type": "text", "id": "name", "label": "Tier name", "default": "Camper" },
        { "type": "text", "id": "threshold", "label": "How to reach it", "default": "Join the camp" },
        { "type": "textarea", "id": "perks", "label": "Perks (one per line)", "default": "Trail dispatches & new-roast alerts\nMember-only seasonal drops\nBirthday treat" },
        { "type": "checkbox", "id": "featured", "label": "Highlight this tier", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Trail Rewards",
    "blocks": [
      { "type": "tier", "settings": { "icon": "seed", "name": "Camper", "threshold": "Join the camp", "perks": "Trail dispatches & new-roast alerts\nMember-only seasonal drops\nBirthday treat", "featured": false } },
      { "type": "tier", "settings": { "icon": "pine", "name": "Trailblazer", "threshold": "3+ orders or 3 badges", "perks": "Everything in Camper\nEarly access to new roasts\nFree shipping perks\nCollect all 5 camp badges", "featured": true } },
      { "type": "tier", "settings": { "icon": "trophy", "name": "Forest Legend", "threshold": "Top of the trail", "perks": "Everything in Trailblazer\nFirst dibs on limited drops\nA little something extra in every box\nName in the trail journal", "featured": false } }
    ]
  }]
}
{% endschema %}
