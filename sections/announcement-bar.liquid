<div class="announcement" role="region" aria-label="Announcements">
  <div class="announcement__track">
    {%- for block in section.blocks -%}
      <span class="announcement__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != 'none' -%}{% render 'icon', name: block.settings.icon, size: 15 %}{%- endif -%}
        {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}{{ block.settings.text }}{%- endif -%}
      </span>
    {%- else -%}
      <span class="announcement__item">{% render 'icon', name: 'fire', size: 15 %} Roasted over the perfect fire · Free shipping over ${{ settings.free_ship_threshold }}</span>
      <span class="announcement__item">{% render 'icon', name: 'star', size: 15 %} New to the camp? Code <strong>WELCOME10</strong> = 10% off your first order</span>
    {%- endfor -%}
  </div>
</div>
{% schema %}
{
  "name": "Announcement bar",
  "settings": [],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Nature Calls, Coffee Answers." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "leaf", "options": [
          { "value": "none", "label": "None" }, { "value": "leaf", "label": "Leaf" }, { "value": "fire", "label": "Fire" },
          { "value": "truck", "label": "Truck" }, { "value": "pine", "label": "Pine" }, { "value": "star", "label": "Star" }
        ]}
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "message", "settings": { "text": "Nature Calls, Coffee Answers.", "icon": "leaf" } },
      { "type": "message", "settings": { "text": "Free shipping over $45 · Roasted to order", "icon": "truck" } }
    ]
  }
}
{% endschema %}
