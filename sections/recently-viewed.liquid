<div data-recently-viewed-section>
  <section class="section" aria-label="Recently viewed">
    <div class="page-width">
      <div class="section-head"><p class="eyebrow" style="justify-content:center">Back down the trail</p><h2>{{ section.settings.heading | default: 'Recently Viewed' }}</h2></div>
      <div data-recently-viewed data-current-handle="{{ product.handle }}">
        <div class="product-grid" data-rv-grid></div>
      </div>
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Recently viewed",
  "tag": "section",
  "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Recently Viewed" } ]
}
{% endschema %}
