{%- comment -%}
  Reasons to buy — compact icon strip answering "Why THIS coffee?"
{%- endcomment -%}
<section class="reasons section--tight" aria-label="{{ section.settings.heading | default: 'Why Sasquatch Coffee' | escape }}" style="position:relative">
  {% render 'hidden-bean', bean_id: 'reasons', pos: 'right:3%;top:1.1rem' %}
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="reasons__head">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="reasons__strip" data-reveal-stagger>
      {%- for block in section.blocks -%}
        <div class="reason" {{ block.shopify_attributes }}>
          <span class="reason__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <span class="reason__label">{{ block.settings.label }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ section.id }} .reasons { background: {{ section.settings.bg }}; color: {{ section.settings.text_color }}; padding-block: clamp(1.4rem, 3vw, 2.4rem); }
  #shopify-section-{{ section.id }} .reasons__head { text-align: center; font-size: clamp(1.1rem, 2.2vw, 1.5rem); margin: 0 0 1.1rem; color: inherit; }
  #shopify-section-{{ section.id }} .reasons__strip { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(.6rem, 2.4vw, 2.4rem) clamp(1rem, 3vw, 2.8rem); }
  #shopify-section-{{ section.id }} .reason { display: flex; flex-direction: column; align-items: center; gap: .45rem; text-align: center; min-width: 88px; flex: 0 1 120px; }
  #shopify-section-{{ section.id }} .reason__icon { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.22); color: {{ section.settings.icon_color }}; }
  #shopify-section-{{ section.id }} .reason__label { font-weight: 700; font-size: .82rem; line-height: 1.2; letter-spacing: .01em; }
  @media (max-width: 749px) { #shopify-section-{{ section.id }} .reason { flex-basis: 27%; min-width: 0; } #shopify-section-{{ section.id }} .reason__icon { width: 46px; height: 46px; } }
</style>

{% schema %}
{
  "name": "Reasons to buy",
  "tag": "section",
  "class": "section-reasons",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why Sasquatch Coffee?" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#1f3d2b" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#faf3e4" },
    { "type": "color", "id": "icon_color", "label": "Icon", "default": "#f2c14e" }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "fire", "options": [
          {"value":"fire","label":"Fire"},{"value":"seed","label":"Bean"},{"value":"mountain","label":"Mountain"},{"value":"medal","label":"Medal"},{"value":"shield","label":"Shield"},{"value":"truck","label":"Truck"},{"value":"leaf","label":"Leaf"},{"value":"star","label":"Star"},{"value":"mug","label":"Mug"},{"value":"globe","label":"Globe"},{"value":"clock","label":"Clock"},{"value":"map","label":"Map"},{"value":"pine","label":"Pine"}
        ]},
        { "type": "text", "id": "label", "label": "Label", "default": "Fresh Roasted" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Reasons to buy",
    "blocks": [
      { "type": "reason", "settings": { "icon": "seed", "label": "Small Batch" } },
      { "type": "reason", "settings": { "icon": "fire", "label": "Fresh Roasted" } },
      { "type": "reason", "settings": { "icon": "mountain", "label": "Single Origin" } },
      { "type": "reason", "settings": { "icon": "medal", "label": "Premium Arabica" } },
      { "type": "reason", "settings": { "icon": "star", "label": "Roasted in USA" } },
      { "type": "reason", "settings": { "icon": "truck", "label": "Fast Shipping" } },
      { "type": "reason", "settings": { "icon": "shield", "label": "Satisfaction Guarantee" } }
    ]
  }]
}
{% endschema %}
