{%- liquid
  assign source = product.collections.first
  assign limit = section.settings.limit | default: 4
-%}
{%- if source and source.products.size > 1 -%}
  <section class="section" aria-label="You might also like">
    <div class="page-width">
      <div class="section-head" data-reveal>
        <p class="eyebrow" style="justify-content:center">Frequently brewed together</p>
        <h2>{{ section.settings.heading | default: 'You might also like' }}</h2>
      </div>
      <div class="product-grid" data-reveal-stagger>
        {%- assign shown = 0 -%}
        {%- for p in source.products -%}
          {%- if p.id != product.id and shown < limit -%}
            {% render 'product-card', product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{
  "name": "Related products",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 }
  ]
}
{% endschema %}
