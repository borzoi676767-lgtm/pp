<section class="section" style="color:var(--cream-100);text-align:center">
  <div class="page-width page-width--narrow">
    {%- if settings.brand_emblem -%}<img src="{{ settings.brand_emblem | image_url: width: 200 }}" alt="{{ shop.name }}" width="96" height="96" style="margin:0 auto 1.4rem;border-radius:50%">{%- else -%}<img src="{{ 'emblem.webp' | asset_url }}" alt="{{ shop.name }}" width="120" height="120" style="margin:0 auto 1.4rem">{%- endif -%}
    <p class="eyebrow" style="justify-content:center;color:var(--gold-400)">A hidden roastery in the woods</p>
    <h1 style="color:#fff">{{ shop.name }}</h1>
    <p class="lede" style="color:rgba(255,255,255,.9)">{{ page_description | default: 'The fire is lit and the beans are roasting. We open soon — leave your email and we\'ll call you down the trail.' }}</p>

    {%- form 'customer' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <div class="input-group" style="max-width:440px;margin:1.4rem auto 0">
        <input class="input" type="email" name="contact[email]" placeholder="you@trail.com" required aria-label="Email">
        <button type="submit" class="btn btn--accent">Notify me</button>
      </div>
      {%- if form.posted_successfully? -%}<p class="form-success">You're on the list — see you soon by the fire!</p>{%- endif -%}
    {%- endform -%}

    <div style="margin-top:2.5rem">
      <p style="color:rgba(255,255,255,.7);font-size:.9rem">Store owner? <a href="#" onclick="document.getElementById('pw').hidden=false;return false;" style="color:var(--gold-400)">Enter using password</a></p>
      <div id="pw" hidden style="max-width:360px;margin:1rem auto 0">
        {%- form 'storefront_password' -%}
          {{ form.errors | default_errors }}
          <div class="input-group"><input class="input" type="password" name="password" placeholder="Password" aria-label="Store password"><button class="btn btn--gold" type="submit">Enter</button></div>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}
