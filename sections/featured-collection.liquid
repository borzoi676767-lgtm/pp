{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.products_to_show
-%}
<section class="section" aria-label="{{ section.settings.heading | default: 'Featured' | escape }}">
  <div class="page-width">
    <div class="collection-toolbar" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 style="margin:0">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if coll -%}<a href="{{ coll.url }}" class="link-arrow">View all {% render 'icon', name: 'arrow-right', size: 16 %}</a>{%- endif -%}
    </div>

    {%- if coll and coll.products.size > 0 -%}
      <div class="{% if section.settings.layout == 'carousel' %}product-scroller{% else %}product-grid{% endif %}" data-reveal-stagger>
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, lazy: forloop.first %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="muted">Select a collection in the theme editor.</p>
    {%- endif -%}
  </div>
</section>
<style>
  #shopify-section-{{ section.id }} .product-scroller { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 280px); gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 1rem; scrollbar-width: thin; }
  #shopify-section-{{ section.id }} .product-scroller > * { scroll-snap-align: start; }
</style>
{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Camp favorites" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers by the Fire" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 16, "step": 1, "label": "Products to show", "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [ {"value":"grid","label":"Grid"}, {"value":"carousel","label":"Carousel"} ] }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
