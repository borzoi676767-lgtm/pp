{%- paginate blog.articles by 9 -%}
<section class="section" aria-label="{{ blog.title }}">
  <div class="page-width">
    <div class="section-head" data-reveal>
      <p class="eyebrow" style="justify-content:center">The trail journal</p>
      <h1>{{ blog.title }}</h1>
    </div>
    <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr))" data-reveal-stagger>
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          <div class="article-card__media">
            {%- if article.image -%}<img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape | default: article.title }}" width="400" height="250" loading="lazy">{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <p class="article-card__meta">{{ article.published_at | date: '%b %d, %Y' }}{% if article.author %} · {{ article.author }}{% endif %}</p>
          <h2 class="article-card__title">{{ article.title }}</h2>
          <p class="muted">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
        </a>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Blog", "tag": "section", "settings": [], "enabled_on": { "templates": ["blog"] } }
{% endschema %}
