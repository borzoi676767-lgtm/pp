<div class="page-width section">
  <div class="auth-card">
    <div class="section-head" style="margin-bottom:1rem"><h1 style="margin:0">Reset your password</h1></div>
    {%- form 'reset_customer_password' -%}
      {{ form.errors | default_errors }}
      <div class="field"><label for="np">New password</label><input class="input" type="password" name="customer[password]" id="np" required></div>
      <div class="field"><label for="np2">Confirm password</label><input class="input" type="password" name="customer[password_confirmation]" id="np2" required></div>
      <button type="submit" class="btn btn--accent btn--full">Reset password</button>
    {%- endform -%}
  </div>
</div>
